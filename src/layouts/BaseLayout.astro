---
import { ClientRouter } from "astro:transitions"

import { TopNav } from "@/components/navigation/TopNav"
import "@/styles/global.css"

interface Props {
  title?: string
  description?: string
  image?: string
}

const {
  title = "3D 产品动态设计师作品集 | Motion Atelier",
  description = "面向科技品牌、硬件产品和未来界面的 3D 产品动画与动态视觉作品集。",
  image = "/thumbnails/work-01.jpg",
} = Astro.props
---

<!doctype html>
<html lang="zh-CN" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Motion Atelier" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <script is:inline>
      const savedTheme = window.localStorage.getItem("theme");
      const theme = savedTheme === "light" ? "light" : "dark";
      document.documentElement.classList.toggle("dark", theme === "dark");
      document.documentElement.dataset.theme = theme;
    </script>
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body>
    <TopNav client:load />
    <main class="view-soft min-h-dvh">
      <slot />
    </main>
    <footer class="border-t border-border/60 px-6 py-12 text-center text-xs text-muted-foreground space-y-2">
      <p class="font-medium text-foreground">Motion Atelier · 3D Product Motion Design</p>
      <p>广州 / 远程协作 · Cinema 4D / Octane / Redshift / After Effects</p>
      <p class="text-[11px] text-muted-foreground/70">© {new Date().getFullYear()} Motion Portfolio. All rights reserved.</p>
    </footer>
  </body>
</html>
