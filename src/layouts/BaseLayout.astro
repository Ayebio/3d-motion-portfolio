---
import { ClientRouter } from "astro:transitions"

import { TopNav } from "@/components/navigation/TopNav"
import "@/styles/global.css"

interface Props {
  title?: string
  description?: string
  image?: string
}

const {
  title = "Yang Zongye · 三维产品动态设计师 | 作品集",
  description = "Yang Zongye（三维产品动态设计师）商业作品集：聚焦 3D 产品动画、工业硬件解构、界面动效与品牌视觉影像。",
  image = "/thumbnails/work-01.jpg",
} = Astro.props
---

<!doctype html>
<html lang="zh-CN" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Yang Zongye · 三维产品动态设计师" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <script is:inline>
      function applySavedTheme() {
        const savedTheme = window.localStorage.getItem("theme");
        const theme = savedTheme === "light" ? "light" : "dark";
        document.documentElement.classList.toggle("dark", theme === "dark");
        document.documentElement.dataset.theme = theme;
      }

      applySavedTheme();
      document.addEventListener("astro:after-swap", applySavedTheme);
    </script>
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body>
    <TopNav client:load />
    <main class="view-soft min-h-dvh">
      <slot />
    </main>
    <footer class="border-t border-border/60 px-6 py-12 text-center text-xs text-muted-foreground space-y-2">
      <p class="font-medium text-foreground">Yang Zongye · 三维产品动态设计师</p>
      <p>广州 / 远程协作 · Cinema 4D / Redshift / After Effects / Seedance</p>
      <p class="text-[11px] text-muted-foreground/75">© {new Date().getFullYear()} Yang Zongye. All rights reserved.</p>
    </footer>
  </body>
</html>
