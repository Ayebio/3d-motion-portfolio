---
import { ClientRouter } from "astro:transitions"

import { TopNav } from "@/components/navigation/TopNav"
import { PROFILE } from "@/data/profile"
import "@/styles/global.css"

interface Props {
  title?: string
  description?: string
  image?: string
}

const {
  title = `${PROFILE.name} · 三维产品动态设计师 | 作品集`,
  description = `${PROFILE.name}（三维视频设计师 / 视频创意主导）商业作品集：近 4 年出海智能硬件 3D 产品发布片、工业机械解构与 3D + AI 实拍级混合工作流。`,
  image = PROFILE.showreel.posterSrc,
} = Astro.props

const currentPath = Astro.url.pathname
---

<!doctype html>
<html lang="zh-CN" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content={`${PROFILE.name} · 三维产品动态设计师`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <script is:inline>
      function applySavedTheme() {
        const savedTheme = window.localStorage.getItem("theme");
        const theme = savedTheme === "light" ? "light" : "dark";
        document.documentElement.classList.toggle("dark", theme === "dark");
        document.documentElement.dataset.theme = theme;
      }

      applySavedTheme();
      document.addEventListener("astro:after-swap", applySavedTheme);
    </script>
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body>
    <TopNav client:load initialPath={currentPath} />
    <main class="view-soft min-h-dvh">
      <slot />
    </main>
    <footer class="border-t border-border/60 px-6 pb-24 pt-10 text-center text-xs text-muted-foreground space-y-2 sm:py-12">
      <p class="font-medium text-foreground">{PROFILE.name} · {PROFILE.title}</p>
      <p>{PROFILE.location} · {PROFILE.footerPipeline}</p>
      <p class="text-[11px] text-muted-foreground/75">© {new Date().getFullYear()} {PROFILE.name}. All rights reserved.</p>
    </footer>
  </body>
</html>
