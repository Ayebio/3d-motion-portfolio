---
import fs from "node:fs"
import path from "node:path"
import { ArrowLeft, ArrowUpRight, Briefcase, Cpu, Film, Layers, Mail, MapPin, Sparkles } from "lucide-react"

import { ResumeDownloadButton } from "@/components/about/ResumeDownloadButton"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { getPortfolioEntries } from "@/lib/contentful"

const projects = await getPortfolioEntries()

const resumeCandidates = ["Yang-Zongye-Resume.pdf", "resume.pdf"]
const foundPdf = resumeCandidates.find((file) => fs.existsSync(path.join(process.cwd(), "public", file)))
const resumePdfHref = foundPdf ? `/${foundPdf}` : null

const skillGroups = [
  {
    title: "三维建模与动画",
    items: ["Cinema 4D", "Houdini", "产品结构拆解", "机械与硬件动态绑定"],
  },
  {
    title: "材质、灯光与渲染",
    items: ["Octane Render", "Redshift", "Substance 3D", "工业材质与布光"],
  },
  {
    title: "后期合成与剪辑",
    items: ["After Effects", "Premiere Pro", "DaVinci Resolve", "界面交互动效"],
  },
  {
    title: "AIGC 视觉工作流",
    items: ["AI 概念视觉探索", "风格化短片试验", "图像与动态辅助生成"],
  },
]

const workflowSteps = [
  {
    step: "01",
    title: "需求与脚本对齐",
    desc: "确认产品核心卖点、片长、应用场景（发布会 / 官网 / 社媒）及交付周期。",
  },
  {
    step: "02",
    title: "分镜与风格测试",
    desc: "输出镜头脚本与关键静帧风格测试，提前锁定光影基调与运动节奏。",
  },
  {
    step: "03",
    title: "三维制作与渲染",
    desc: "完成产品建模优化、结构动画、材质灯光与多通道三维序列渲染。",
  },
  {
    step: "04",
    title: "合成剪辑与交付",
    desc: "后期特效合成、调色与多规格成片输出，支持国内外平台传播规格。",
  },
]
---

<BaseLayout
  title="关于我与简历 | Yang Zongye · 三维产品动态设计师"
  description="Yang Zongye（三维产品动态设计师）个人简介、核心技术管线、合作流程与简历 PDF 下载。"
>
  <section class="px-6 pb-24 pt-28 print:px-0 print:py-4">
    <div class="mx-auto max-w-5xl space-y-12">
      <div class="flex flex-wrap items-center justify-between gap-4 print:hidden">
        <a
          href="/#work"
          class="inline-flex items-center gap-2 rounded-md border border-border px-3 py-2 text-sm text-muted-foreground outline-none hover:bg-secondary hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring/50 active:scale-95"
        >
          <ArrowLeft className="size-4" aria-hidden="true" />
          返回精选案例
        </a>

        <div class="flex flex-wrap items-center gap-3">
          <ResumeDownloadButton client:load pdfHref={resumePdfHref} />
          <a
            href="/contact"
            class="inline-flex h-10 items-center gap-1.5 rounded-md border border-border px-4 text-sm font-medium text-foreground hover:bg-secondary transition"
          >
            联系合作
            <ArrowUpRight className="size-4" aria-hidden="true" />
          </a>
        </div>
      </div>

      {/* Main Resume / About Card */}
      <div
        id="resume"
        class="rounded-2xl border border-border/80 bg-card/85 p-6 shadow-soft sm:p-10 print:border-none print:bg-white print:text-black print:shadow-none print:p-0"
      >
        <div class="flex flex-col gap-6 border-b border-border/70 pb-8 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-xs font-medium uppercase tracking-[0.28em] text-muted-foreground print:text-neutral-500">
              About & Resume / 个人履历
            </p>
            <h1 class="mt-3 text-4xl font-bold tracking-tight text-foreground sm:text-5xl print:text-black">
              Yang Zongye
            </h1>
            <p class="mt-2 text-lg font-medium text-muted-foreground print:text-neutral-700">
              三维产品动态设计师 · 3D Product Motion Designer
            </p>
          </div>

          <div class="space-y-1.5 text-xs text-muted-foreground sm:text-right print:text-neutral-700">
            <p class="flex items-center gap-1.5 sm:justify-end">
              <MapPin className="size-3.5 text-primary print:text-black" />
              广州 / 支持国内外远程协作
            </p>
            <p class="flex items-center gap-1.5 sm:justify-end">
              <Mail className="size-3.5 text-primary print:text-black" />
              2872594253@qq.com · 微信 2872594253
            </p>
          </div>
        </div>

        {/* Profile Summary */}
        <div class="grid gap-8 border-b border-border/70 py-8 lg:grid-cols-[1.35fr_1fr]">
          <div class="space-y-4">
            <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-muted-foreground print:text-neutral-600">
              个人简介
            </h2>
            <p class="text-sm leading-7 text-foreground/90 sm:text-base print:text-neutral-800">
              专注于商业三维产品动画、工业硬件功能解构、智能设备中控界面动效与 AIGC 视觉探索。
              长期服务科技硬件与智能设备品牌，擅长在三维光影、机械运动节奏与产品卖点之间建立清晰直觉的视觉表达，帮助产品在发布会、官网首屏与商业推广中建立强记忆点。
            </p>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div class="rounded-xl border border-border/70 bg-background/60 p-4 print:border-neutral-300 print:bg-neutral-50">
              <p class="text-xs text-muted-foreground print:text-neutral-600">已收录商业项目</p>
              <p class="mt-1 text-2xl font-bold text-foreground print:text-black">{projects.length}+</p>
            </div>
            <div class="rounded-xl border border-border/70 bg-background/60 p-4 print:border-neutral-300 print:bg-neutral-50">
              <p class="text-xs text-muted-foreground print:text-neutral-600">核心覆盖领域</p>
              <p class="mt-1 text-sm font-semibold text-foreground print:text-black">硬件 TVC / 机器人 / UI / AIGC</p>
            </div>
            <div class="col-span-2 rounded-xl border border-border/70 bg-background/60 p-4 print:border-neutral-300 print:bg-neutral-50">
              <p class="text-xs text-muted-foreground print:text-neutral-600">代表合作品牌与项目方向</p>
              <p class="mt-1 text-sm font-medium text-foreground print:text-black">
                Aquark、Fairland、吉尼斯相关产品片、CES 展会视觉、水下与割草机器人系列
              </p>
            </div>
          </div>
        </div>

        {/* Core Skills */}
        <div class="border-b border-border/70 py-8">
          <h2 class="mb-5 flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.18em] text-muted-foreground print:text-neutral-600">
            <Layers className="size-4 text-primary print:text-black" />
            核心技能与工具链
          </h2>
          <div class="grid gap-4 sm:grid-cols-2">
            {skillGroups.map((group) => (
              <div class="rounded-xl border border-border/70 bg-background/50 p-4 print:border-neutral-300 print:bg-white">
                <p class="text-sm font-semibold text-foreground print:text-black">{group.title}</p>
                <div class="mt-3 flex flex-wrap gap-1.5">
                  {group.items.map((item) => (
                    <span class="rounded-md border border-border/70 bg-secondary/70 px-2.5 py-1 text-xs text-foreground print:border-neutral-300 print:bg-neutral-100 print:text-black">
                      {item}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* Selected Domain Highlights */}
        <div class="border-b border-border/70 py-8">
          <h2 class="mb-5 flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.18em] text-muted-foreground print:text-neutral-600">
            <Briefcase className="size-4 text-primary print:text-black" />
            擅长项目类型
          </h2>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <div class="space-y-1.5">
              <p class="flex items-center gap-1.5 text-sm font-semibold text-foreground print:text-black">
                <Film className="size-3.5 text-primary print:text-black" />
                商业 TVC 与发布片
              </p>
              <p class="text-xs leading-6 text-muted-foreground print:text-neutral-700">
                新品上市主视觉、官网首屏视频与品牌形象宣传片。
              </p>
            </div>
            <div class="space-y-1.5">
              <p class="flex items-center gap-1.5 text-sm font-semibold text-foreground print:text-black">
                <Cpu className="size-3.5 text-primary print:text-black" />
                智能硬件与机器人
              </p>
              <p class="text-xs leading-6 text-muted-foreground print:text-neutral-700">
                水下机器人、激光雷达割草机、热泵设备的结构拆解与原理动态。
              </p>
            </div>
            <div class="space-y-1.5">
              <p class="flex items-center gap-1.5 text-sm font-semibold text-foreground print:text-black">
                <Layers className="size-3.5 text-primary print:text-black" />
                硬件中控界面动效
              </p>
              <p class="text-xs leading-6 text-muted-foreground print:text-neutral-700">
                软硬件联动控制界面、状态切换与屏幕空间动态演绎。
              </p>
            </div>
            <div class="space-y-1.5">
              <p class="flex items-center gap-1.5 text-sm font-semibold text-foreground print:text-black">
                <Sparkles className="size-3.5 text-primary print:text-black" />
                AIGC 视觉创作
              </p>
              <p class="text-xs leading-6 text-muted-foreground print:text-neutral-700">
                结合生成式工具进行前期概念探索、风格化视觉与实验短片。
              </p>
            </div>
          </div>
        </div>

        {/* Commercial Cooperation Flow */}
        <div class="pt-8">
          <h2 class="mb-5 text-sm font-semibold uppercase tracking-[0.18em] text-muted-foreground print:text-neutral-600">
            商业合作流程
          </h2>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {workflowSteps.map((item) => (
              <div class="rounded-xl border border-border/70 bg-background/50 p-4 print:border-neutral-300 print:bg-white">
                <span class="font-mono text-xs font-semibold text-primary print:text-black">{item.step}</span>
                <p class="mt-1.5 text-sm font-semibold text-foreground print:text-black">{item.title}</p>
                <p class="mt-1.5 text-xs leading-5 text-muted-foreground print:text-neutral-700">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      {!resumePdfHref && (
        <p class="text-center text-xs text-muted-foreground print:hidden">
          提示：点击上方「导出 / 打印简历 (PDF)」可直接另存为 PDF 简历；如需提供独立排版版，将文件放至{" "}
          <code class="rounded bg-secondary px-1.5 py-0.5 font-mono text-[11px]">public/Yang-Zongye-Resume.pdf</code>{" "}
          即可自动切换为直接下载。
        </p>
      )}
    </div>
  </section>
</BaseLayout>
