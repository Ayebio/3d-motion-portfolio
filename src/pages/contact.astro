---
import { ContactForm } from "@/components/contact/ContactForm"
import { ContactInfo } from "@/components/contact/ContactInfo"
import BaseLayout from "@/layouts/BaseLayout.astro"
---

<BaseLayout title="联系合作 | 3D 产品动态设计作品集">
  <section class="px-6 pb-24 pt-28">
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1fr_1.1fr] lg:items-start">
      <ContactInfo client:load />
      <div class="space-y-4">
        <div class="mb-2">
          <h2 class="text-lg font-semibold text-foreground">在线发送项目需求</h2>
          <p class="text-xs text-muted-foreground">填写基本信息与产品类型，我们将评估周期与方案并及时答复</p>
        </div>
        <ContactForm client:load />
      </div>
    </div>
  </section>
</BaseLayout>
