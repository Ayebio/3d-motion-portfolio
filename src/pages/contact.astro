import { ContactQrCards } from "@/components/contact/ContactQrCards"
import BaseLayout from "@/layouts/BaseLayout.astro"
---

<BaseLayout title="联系合作与求职沟通 | Yang Zongye · 三维产品动态设计师">
  <section class="px-6 pb-24 pt-28">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.95fr_1.15fr] lg:items-start">
      <ContactInfo client:load />
      <ContactQrCards client:load />
    </div>
  </section>
</BaseLayout>
