---
import { ArrowLeft, ArrowRight, ExternalLink, Layers, Monitor, Calendar, Briefcase, Tv } from "lucide-react"

import { VideoPlayer } from "@/components/video/VideoPlayer"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { getPortfolioEntries } from "@/lib/contentful"
import type { PortfolioProject } from "@/data/projects"

export async function getStaticPaths() {
  const projects = await getPortfolioEntries()

  return projects.map((project, index) => {
    const prevProject = index > 0 ? projects[index - 1] : projects[projects.length - 1]
    const nextProject = index < projects.length - 1 ? projects[index + 1] : projects[0]

    return {
      params: { slug: project.slug },
      props: { project, prevProject, nextProject },
    }
  })
}

interface Props {
  project: PortfolioProject
  prevProject: PortfolioProject
  nextProject: PortfolioProject
}

const { project, prevProject, nextProject } = Astro.props
const heroImage = project.images[0]
const heroImageSrc = typeof heroImage.src === "string" ? heroImage.src : heroImage.src.src

function getProjectImageSrc(p: PortfolioProject) {
  const img = p.images[0]
  return typeof img.src === "string" ? img.src : img.src.src
}
---

<BaseLayout title={`${project.title} | Yang Zongye · 三维产品动态设计师`} description={project.description} image={heroImageSrc}>
  <article class="pb-24 pt-20">
    {/* Hero Section inside theme-safe dark cinema frame */}
    <section class="px-4 sm:px-6">
      <div class="relative isolate mx-auto flex min-h-[46svh] max-w-6xl flex-col justify-end overflow-hidden rounded-2xl border border-border/60 bg-neutral-950 px-6 pb-10 pt-14 shadow-soft-lg sm:px-10 sm:pb-12">
        <img
          src={heroImageSrc}
          alt={heroImage.alt}
          class="absolute inset-0 -z-20 h-full w-full object-cover opacity-50 filter blur-sm scale-105"
          loading="eager"
        />
        <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(8,8,8,0.4),rgba(8,8,8,0.86)_75%,rgba(8,8,8,0.96))]"></div>

        <div class="mb-6 flex flex-wrap items-center gap-2">
          <a
            href="/#work"
            class="inline-flex w-fit items-center gap-1.5 rounded-full border border-white/20 bg-black/45 px-3.5 py-1.5 text-xs font-medium text-white/85 backdrop-blur-md hover:bg-white/15 hover:text-white transition-all active:scale-95"
          >
            <ArrowLeft className="size-3.5" aria-hidden="true" />
            返回精选案例
          </a>
          <a
            href="/archive"
            class="inline-flex w-fit items-center rounded-full border border-white/15 bg-black/30 px-3.5 py-1.5 text-xs font-medium text-white/75 backdrop-blur-md hover:bg-white/15 hover:text-white transition-all active:scale-95"
          >
            全部作品归档
          </a>
        </div>

        <div class="mb-3 flex flex-wrap items-center gap-2">
          <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-black shadow-sm">
            {project.role}
          </span>
          <span class="rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-medium text-white/85 backdrop-blur-md">
            {project.category}
          </span>
          <span class="rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-mono text-white/85 backdrop-blur-md">
            {project.dateLabel || project.year}
          </span>
        </div>

        <h1 class="text-balance text-3xl font-bold tracking-tight text-white sm:text-5xl">
          {project.title}
        </h1>
        <p class="mt-4 max-w-3xl text-sm leading-relaxed text-white/80 sm:text-base">
          {project.description}
        </p>
      </div>
    </section>

    {/* Video & Specs Section */}
    <section class="px-6 py-12">
      <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[1fr_340px]">
        {/* Main Video Box */}
        <div class="space-y-4">
          <VideoPlayer
            client:load
            title={project.title}
            videoSrc={project.videoSrc}
            posterUrl={heroImageSrc}
            bilibiliUrl={project.bilibiliUrl}
            youtubeUrl={project.videoUrl}
          />

          {(project.bilibiliUrl || project.videoUrl) && (
            <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-border/70 bg-card/80 px-4 py-3 text-xs">
              <span class="flex items-center gap-1.5 text-muted-foreground">
                <Tv className="size-3.5 text-primary" />
                备用外部播放线路（若当前网络加载较慢可切换）：
              </span>
              <div class="flex flex-wrap items-center gap-2">
                {project.bilibiliUrl && (
                  <a
                    href={project.bilibiliUrl}
                    target="_blank"
                    rel="noreferrer"
                    class="inline-flex items-center gap-1 rounded-md border border-border bg-secondary/70 px-3 py-1.5 font-medium text-foreground hover:bg-secondary transition"
                  >
                    Bilibili 观看（国内直连）
                    <ExternalLink className="size-3 text-muted-foreground" />
                  </a>
                )}
                {project.videoUrl && (
                  <a
                    href={project.videoUrl}
                    target="_blank"
                    rel="noreferrer"
                    class="inline-flex items-center gap-1 rounded-md border border-border bg-secondary/70 px-3 py-1.5 font-medium text-foreground hover:bg-secondary transition"
                  >
                    YouTube 观看（海外）
                    <ExternalLink className="size-3 text-muted-foreground" />
                  </a>
                )}
              </div>
            </div>
          )}

          {project.highlights && project.highlights.length > 0 && (
            <div class="rounded-xl border border-border/70 bg-card/80 p-6 backdrop-blur-xl">
              <h2 class="text-base font-semibold text-foreground">项目要点</h2>
              <ul class="mt-3 space-y-2 text-sm leading-relaxed text-muted-foreground list-disc pl-5">
                {project.highlights.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          )}
        </div>

        {/* Sidebar Specifications */}
        <aside class="space-y-6">
          <div class="rounded-xl border border-border/80 bg-card/85 p-6 backdrop-blur-xl space-y-5">
            <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground">
              Project Info / 项目信息
            </h2>

            <div class="space-y-4 text-sm divide-y divide-border/60">
              <div class="pt-3 first:pt-0">
                <p class="text-xs text-muted-foreground flex items-center gap-1.5">
                  <Briefcase className="size-3.5" />
                  品牌 / 客户
                </p>
                <p class="mt-1 font-medium text-foreground">{project.client || "商业合作项目"}</p>
              </div>

              <div class="pt-3">
                <p class="text-xs text-muted-foreground flex items-center gap-1.5">
                  <Calendar className="size-3.5" />
                  年份
                </p>
                <p class="mt-1 font-medium text-foreground">{project.dateLabel || project.year}</p>
              </div>

              {project.deliverables && (
                <div class="pt-3">
                  <p class="text-xs text-muted-foreground flex items-center gap-1.5">
                    <Monitor className="size-3.5" />
                    交付规格
                  </p>
                  <p class="mt-1 font-mono text-xs text-foreground/90">{project.deliverables}</p>
                </div>
              )}

              <div class="pt-3">
                <p class="text-xs text-muted-foreground flex items-center gap-1.5 mb-1.5">
                  <Layers className="size-3.5" />
                  常用工具链
                </p>
                <div class="mt-2 flex flex-wrap gap-1.5">
                  {project.tools.map((tool) => (
                    <span class="rounded bg-secondary px-2 py-0.5 text-xs font-medium text-secondary-foreground border border-border/60">
                      {tool}
                    </span>
                  ))}
                </div>
              </div>

              <div class="pt-3">
                <p class="text-xs text-muted-foreground mb-2">项目标签</p>
                <div class="flex flex-wrap gap-1.5">
                  {project.tags.map((tag) => (
                    <span class="rounded-full border border-border px-2.5 py-0.5 text-[11px] text-muted-foreground">
                      #{tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <div class="pt-2">
              <a
                href="/contact"
                class="flex w-full items-center justify-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-xs font-medium text-primary-foreground outline-none hover:opacity-90 active:scale-95 transition-all shadow-md"
              >
                预约档期 / 联系合作
              </a>
            </div>
          </div>
        </aside>
      </div>
    </section>

    {/* Previous / Next Project Navigation */}
    <section class="mt-12 border-t border-border/80 px-6 pt-12">
      <div class="mx-auto max-w-6xl">
        <p class="text-xs font-medium uppercase tracking-[0.24em] text-muted-foreground text-center mb-8">
          Explore More Works / 浏览更多作品
        </p>

        <div class="grid gap-6 sm:grid-cols-2">
          {/* Previous Card */}
          <a
            href={`/projects/${prevProject.slug}`}
            class="group relative flex items-center gap-4 overflow-hidden rounded-xl border border-border/80 bg-card/80 p-4 transition-all hover:border-foreground/30 hover:bg-card hover:shadow-lg active:scale-[0.99]"
          >
            <div class="relative size-20 shrink-0 overflow-hidden rounded-lg bg-secondary">
              <img
                src={getProjectImageSrc(prevProject)}
                alt={prevProject.title}
                class="h-full w-full object-cover transition duration-500 group-hover:scale-110"
              />
            </div>
            <div class="min-w-0 flex-1">
              <span class="flex items-center gap-1 text-[11px] font-medium text-muted-foreground group-hover:text-primary transition-colors">
                <ArrowLeft className="size-3" />
                上一部作品
              </span>
              <p class="mt-1 truncate text-sm font-semibold text-foreground">
                {prevProject.title}
              </p>
              <p class="text-xs text-muted-foreground">{prevProject.role} · {prevProject.year}</p>
            </div>
          </a>

          {/* Next Card */}
          <a
            href={`/projects/${nextProject.slug}`}
            class="group relative flex items-center justify-between gap-4 overflow-hidden rounded-xl border border-border/80 bg-card/80 p-4 transition-all hover:border-foreground/30 hover:bg-card hover:shadow-lg active:scale-[0.99]"
          >
            <div class="min-w-0 flex-1 text-left sm:text-right">
              <span class="flex items-center gap-1 text-[11px] font-medium text-muted-foreground justify-start sm:justify-end group-hover:text-primary transition-colors">
                下一部作品
                <ArrowRight className="size-3" />
              </span>
              <p class="mt-1 truncate text-sm font-semibold text-foreground">
                {nextProject.title}
              </p>
              <p class="text-xs text-muted-foreground">{nextProject.role} · {nextProject.year}</p>
            </div>
            <div class="relative size-20 shrink-0 overflow-hidden rounded-lg bg-secondary order-first sm:order-last">
              <img
                src={getProjectImageSrc(nextProject)}
                alt={nextProject.title}
                class="h-full w-full object-cover transition duration-500 group-hover:scale-110"
              />
            </div>
          </a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
