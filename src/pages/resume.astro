---
import { ArrowLeft, Mail, MapPin, MessageSquare, Printer } from "lucide-react"

import BaseLayout from "@/layouts/BaseLayout.astro"
import { CORE_STRENGTHS, EXPERIENCES, PROFILE, SKILL_PIPELINES } from "@/data/profile"
import { getPortfolioEntries } from "@/data/projects"

const projects = getPortfolioEntries()
const featuredProjects = projects.filter((p) => p.featured).slice(0, 6)
---

<BaseLayout
  title={`个人简历 | ${PROFILE.name} · ${PROFILE.title}`}
  description={`${PROFILE.name} 个人简历：近 4 年出海智能硬件三维产品动态设计与 3D + AI 混合工作流经验。`}
>
  <section class="px-3.5 pb-24 pt-20 sm:px-6 sm:pb-24 sm:pt-24 print:p-0">
    <div class="mx-auto max-w-4xl">
      {/* Top Action Bar (hidden when printing to PDF) */}
      <div class="mb-6 flex flex-wrap items-center justify-between gap-3 print:hidden">
        <a
          href="/#about"
          class="inline-flex items-center gap-1.5 rounded-full border border-border bg-card/85 px-4 py-2 text-xs font-medium text-foreground hover:bg-secondary transition"
        >
          <ArrowLeft className="size-3.5" aria-hidden="true" />
          返回作品集
        </a>
        <div class="flex items-center gap-2">
          <button
            type="button"
            onclick="window.print()"
            class="inline-flex cursor-pointer items-center gap-1.5 rounded-full bg-primary px-4 py-2 text-xs font-semibold text-primary-foreground shadow-sm hover:opacity-90 active:scale-95 transition"
          >
            <Printer className="size-3.5" aria-hidden="true" />
            打印 / 另存为 PDF 简历
          </button>
        </div>
      </div>

      {/* Printable A4 Resume Sheet */}
      <div class="rounded-2xl border border-border/80 bg-card p-6 sm:p-10 shadow-soft-lg print:rounded-none print:border-0 print:bg-white print:p-6 print:text-black print:shadow-none">
        {/* Header */}
        <header class="border-b border-border/70 pb-6 print:border-neutral-300">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="text-xs font-medium uppercase tracking-[0.24em] text-muted-foreground print:text-neutral-600">
                Curriculum Vitae / 个人简历
              </p>
              <h1 class="mt-2 text-3xl font-bold tracking-tight text-foreground sm:text-4xl print:text-black">
                {PROFILE.name}
              </h1>
              <p class="mt-1 text-sm font-medium text-foreground/85 sm:text-base print:text-neutral-800">
                {PROFILE.title}
              </p>
            </div>
            <div class="space-y-1.5 text-xs text-muted-foreground sm:text-right print:text-neutral-700">
              <p class="flex items-center gap-1.5 sm:justify-end">
                <MapPin className="size-3.5 shrink-0" />
                {PROFILE.location}
              </p>
              <p class="flex items-center gap-1.5 sm:justify-end font-mono">
                <MessageSquare className="size-3.5 shrink-0" />
                微信：{PROFILE.wechat}
              </p>
              <p class="flex items-center gap-1.5 sm:justify-end font-mono">
                <Mail className="size-3.5 shrink-0" />
                {PROFILE.email}
              </p>
            </div>
          </div>
        </header>

        {/* Core Strengths */}
        <section class="mt-7">
          <h2 class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground print:text-neutral-600">
            核心优势 · Core Strengths
          </h2>
          <div class="mt-3.5 grid gap-3 sm:grid-cols-3">
            {CORE_STRENGTHS.map((item) => (
              <div class="rounded-xl border border-border/70 bg-secondary/35 p-4 print:border-neutral-200 print:bg-neutral-50">
                <p class="text-xs font-semibold text-foreground print:text-black">{item.title}</p>
                <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground print:text-neutral-700">
                  {item.description}
                </p>
              </div>
            ))}
          </div>
        </section>

        {/* Experience */}
        <section class="mt-8">
          <h2 class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground print:text-neutral-600">
            工作经历 · Work Experience
          </h2>
          <div class="mt-4 space-y-6">
            {EXPERIENCES.map((exp) => (
              <div class="border-l-2 border-border pl-4 print:border-neutral-300">
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h3 class="text-base font-semibold text-foreground print:text-black">
                    {exp.company}
                  </h3>
                  <span class="font-mono text-xs text-muted-foreground print:text-neutral-600">
                    {exp.period}
                  </span>
                </div>
                <p class="mt-0.5 text-xs font-medium text-foreground/85 print:text-neutral-800">
                  {exp.role} · {exp.location}
                </p>
                <p class="mt-2 text-xs leading-relaxed text-muted-foreground print:text-neutral-700">
                  {exp.summary}
                </p>
                <ul class="mt-2 space-y-1 text-xs leading-relaxed text-muted-foreground list-disc pl-4 print:text-neutral-700">
                  {exp.highlights.map((hl) => (
                    <li>{hl}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>

        {/* Skills Pipeline */}
        <section class="mt-8">
          <h2 class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground print:text-neutral-600">
            专业技能与工具管线 · Skills & Pipeline
          </h2>
          <div class="mt-3.5 grid gap-3 sm:grid-cols-2">
            {SKILL_PIPELINES.map((group) => (
              <div class="rounded-xl border border-border/70 bg-secondary/25 p-4 print:border-neutral-200 print:bg-white">
                <h3 class="text-xs font-semibold text-foreground print:text-black">{group.title}</h3>
                <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground print:text-neutral-700">
                  {group.items.join(" · ")}
                </p>
              </div>
            ))}
          </div>
        </section>

        {/* Selected Projects Summary */}
        <section class="mt-8">
          <h2 class="text-xs font-semibold uppercase tracking-[0.22em] text-muted-foreground print:text-neutral-600">
            代表作品摘要 · Selected Works（共收录 {projects.length} 部）
          </h2>
          <div class="mt-3.5 grid gap-2.5 sm:grid-cols-2">
            {featuredProjects.map((project) => (
              <a
                href={`/projects/${project.slug}`}
                class="block rounded-xl border border-border/70 bg-secondary/25 p-3.5 hover:border-foreground/30 transition print:border-neutral-200 print:bg-white"
              >
                <div class="flex items-center justify-between gap-2">
                  <p class="text-xs font-semibold text-foreground print:text-black">{project.title}</p>
                  <span class="font-mono text-[11px] text-muted-foreground print:text-neutral-600">
                    {project.dateLabel || project.year}
                  </span>
                </div>
                <p class="mt-1 text-[11px] text-muted-foreground print:text-neutral-700">
                  {project.responsibilities}
                </p>
              </a>
            ))}
          </div>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  @media print {
    :global(header),
    :global(footer),
    :global([aria-label="移动端主导航"]) {
      display: none !important;
    }
    :global(body) {
      background: #ffffff !important;
      color: #000000 !important;
    }
  }
</style>
